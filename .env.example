# 复制为 .env 后填写 (.env 已 gitignore)
INFERENCE_API_KEY=            # NVIDIA inference API key (Agent + CV 模型)
BGI_SSH_HOST=user@192.168.x.x # Windows 游戏机 ssh 目标
# BGI_WIN_HOME=C:/Users/djf20  # Windows 脚本/审计文件目录
